{
  "manifest_version": 3,
  "name": "Quietfeed — a social-free X",
  "version": "1.0.0",
  "description": "Strip the social pressure out of X/Twitter. No like counts, no views, no usernames, no timestamps — just the work. Minimal, Pinterest, and Focus views.",
  "permissions": ["storage"],
  "host_permissions": ["*://x.com/*", "*://twitter.com/*", "*://*.twimg.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quietfeed"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["content.js"],
      "css": ["quietfeed.css"],
      "run_at": "document_start"
    }
  ]
}
